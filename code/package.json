{
  "name": "pseudostar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b && tsc -p worker/tsconfig.json",
    "test": "vitest run tests --exclude 'tests/worker/**' --exclude 'tests/e2e/**'",
    "test:language": "vitest run tests/language",
    "test:worker": "vitest run --config tests/worker/vitest.config.ts",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build --output-dir .storybook/build --disable-telemetry",
    "dev:api": "wrangler dev --port 8787 --var APP_ORIGIN:http://127.0.0.1:5173",
    "db:local": "wrangler d1 migrations apply pseudostar --local",
    "deploy": "node scripts/deploy.mjs",
    "format": "prettier --write src worker emails tests scripts .storybook *.ts *.json *.jsonc *.md",
    "format:check": "prettier --check src worker emails tests scripts .storybook *.ts *.json *.jsonc *.md",
    "validate:problems": "vitest run tests/problems",
    "fonts:setup": "node scripts/setup-fonts.mjs",
    "deploy:preflight": "node scripts/preflight.mjs",
    "test:preflight": "node --test scripts/preflight.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "blockly": "13.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-email": "^6.9.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@playwright/test": "^1.63.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "miniflare": "^5.20260903.0-alpha",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
