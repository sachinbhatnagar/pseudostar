{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pseudostar",
  "account_id": "d6f2d5fb08dc097f9e37271271a73bb5",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "pseudostar.stacksauce.dev", "custom_domain": true }],
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pseudostar",
      "database_id": "6212c179-9dfd-48f0-bdac-2af397e82d0b",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_ORIGIN": "https://pseudostar.stacksauce.dev",
    "RESEND_FROM": "PseudoStar <login@pseudostar.stacksauce.dev>",
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": false },
}
